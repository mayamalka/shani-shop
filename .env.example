# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# ---- Database ----
# Docker:            postgresql://shani:shani@localhost:5432/shani
# npm run db:local:  postgresql://shani:shani@localhost:54329/shani
DATABASE_URL=postgresql://shani:shani@localhost:5432/shani

# ---- URLs ----
# Where the website (React app) is opened in the browser
WEB_URL=http://localhost:5173
# Where the API is reachable from the browser (used for payment redirects)
API_URL=http://localhost:3001
API_PORT=3001

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
# Encrypts the admin 2FA secret and signs payment callbacks. 64 hex chars.
APP_SECRET=change-me-to-64-hex-characters-0000000000000000000000000000000000

# ---- Uploaded files ----
UPLOAD_DIR=./uploads

# ---- Email ----
# "file" writes emails to .outbox/ (no setup needed). "smtp" sends via SMTP (Mailpit in docker: localhost:1025).
EMAIL_TRANSPORT=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="הדודה שני <no-reply@hadoda-shani.co.il>"

# ---- Payments ----
# "mock" = fake payment page for development. Later: grow | payplus | cardcom (adapter + keys below).
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ---- Misc ----
NODE_ENV=development
# Set to true only behind HTTPS (production) so cookies get the Secure flag
COOKIE_SECURE=false
