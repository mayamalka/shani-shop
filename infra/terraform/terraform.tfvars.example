# Copy to terraform.tfvars (git-ignored) and fill in.
tenancy_ocid       = "ocid1.tenancy.oc1..xxxx"
compartment_ocid   = "ocid1.tenancy.oc1..xxxx" # root compartment is fine
region             = "il-jerusalem-1"          # your OCI home region
admin_cidrs        = ["203.0.113.7/32"]        # your IP – who may run kubectl
budget_alert_email = "you@example.com"

cloudflare_account_id = "xxxx"
cloudflare_zone_id    = "xxxx"
domain                = "shop.example.com"
# cloudflare_api_token: pass via env var TF_VAR_cloudflare_api_token (never commit it)
