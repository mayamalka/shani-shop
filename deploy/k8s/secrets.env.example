# Copy to deploy/k8s/secrets.env (git-ignored), fill in, then run deploy/k8s/seal-secrets.sh.
# Keep a copy of this file in a password manager – it is the only plain-text copy.

# Encrypts the admin 2FA secrets in the database and signs payment callbacks.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after go-live (the admin's authenticator would stop working).
APP_SECRET=

# Cloudflare R2 API token with "Object Read & Write" on the bucket shani-media (photos)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare R2 API token with "Object Read & Write" on the bucket shani-db-backups (database backups)
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Cloudflare API token: Zone → DNS → Edit, for the shop's zone (Let's Encrypt DNS-01)
CLOUDFLARE_DNS_API_TOKEN=

# SMTP login of the email service (Brevo: SMTP & API → SMTP). Empty = emails fail (logged), orders still work.
SMTP_USER=
SMTP_PASS=

# healthchecks.io check (free) for the monthly restore drill – period 31 days, grace 2 days.
# If the drill fails or doesn't run, healthchecks.io emails you. Example: https://hc-ping.com/<uuid>
RESTORE_DRILL_PING_URL=

# Only while the GHCR images are private: a GitHub token with read:packages
GHCR_USER=
GHCR_TOKEN=
